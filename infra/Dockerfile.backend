FROM python:3.9-slim

WORKDIR /app

# Install system dependencies (needed for some python packages like psycopg2)
RUN apt-get update && apt-get install -y \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Install psycopg2-binary explicitly if not in requirements (common issue)
RUN pip install psycopg2-binary

COPY . .

EXPOSE 8000

# Wait for DB (optional, but good practice is to handle it in entrypoint or retries)
# For MVP, we just run migrate and server
CMD ["sh", "-c", "python manage.py migrate && python manage.py runserver 0.0.0.0:8000"]
